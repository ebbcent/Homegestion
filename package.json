{
  "name": "homegestion",
  "version": "0.1.0",
  "private": true,
  "description": "Gestion des factures, du budget et des dépenses récurrentes de la maison",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "tsc -p server --watch --preserveWatchOutput & node --watch --disable-warning=ExperimentalWarning server/dist/index.js",
    "dev:web": "vite",
    "build": "tsc -p server && tsc -p web --noEmit && vite build",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "start": "node --disable-warning=ExperimentalWarning server/dist/index.js",
    "test": "tsc -p server && node --disable-warning=ExperimentalWarning --test 'server/dist/**/*.test.js'",
    "backup": "node --disable-warning=ExperimentalWarning server/dist/backup.js",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
